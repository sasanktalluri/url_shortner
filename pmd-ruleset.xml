<?xml version="1.0"?>
<ruleset name="url-shortener"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>
        bestpractices/errorprone/design categories, minus three rules that are false positives
        for patterns this codebase intentionally uses (see excludes below). Excluded centrally
        here rather than with @SuppressWarnings in source, so the reasoning lives in one place.
    </description>

    <rule ref="category/java/bestpractices.xml"/>
    <rule ref="category/java/errorprone.xml"/>

    <rule ref="category/java/design.xml">
        <!-- Flags JPA entities (getters, minimal behavior) as "data classes" - that's the
             correct shape for a JPA entity, not a code smell. -->
        <exclude name="DataClass"/>
        <!-- Flags the @SpringBootApplication main class for having only static methods -
             Spring Boot's own convention, not a utility class. -->
        <exclude name="UseUtilityClass"/>
        <!-- Flags a single-level getter call on a locally-obtained domain object
             (e.g. shortUrl.getExpiresAt()) as a Law of Demeter violation - normal, idiomatic
             Java, not a real coupling problem at that depth. -->
        <exclude name="LawOfDemeter"/>
    </rule>

</ruleset>
